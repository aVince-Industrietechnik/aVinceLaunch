#, python-format
msgid "The aVinceLaunch helpers are not installed (no %s)."
msgstr "Die aVinceLaunch-Helfer sind nicht installiert (kein %s)."

msgid "The earlier files are back. Log out and in again to start them."
msgstr "Die früheren Dateien sind zurück. Zum Starten ab- und wieder anmelden."

msgid "This is not a launcher and stays on the desktop. Only launchers can be moved into a fence."
msgid_plural "These are not launchers and stay on the desktop. Only launchers can be moved into a fence."
msgstr[0] "Das ist kein Programmsymbol und bleibt auf dem Schreibtisch. In einen Fence lassen sich nur Programmsymbole verschieben."
msgstr[1] "Das sind keine Programmsymbole und sie bleiben auf dem Schreibtisch. In einen Fence lassen sich nur Programmsymbole verschieben."

msgid "Unknown group:"
msgstr "Unbekannte Gruppe:"

msgid ""
"Usage:\n"
"  launcher-watch                    start the watcher (autostart)\n"
"  launcher-watch --baseline         mark today's programs as seen\n"
"  launcher-watch --suggest FILE     show the suggestion for a .desktop file\n"
"  launcher-watch --check            check the suggestions for all programs\n"
"  launcher-watch --write-rules      create rules.json from the example"
msgstr ""
"Verwendung:\n"
"  launcher-watch                    Wächter starten (Autostart)\n"
"  launcher-watch --baseline         heutigen Bestand als gesehen vermerken\n"
"  launcher-watch --suggest DATEI    Vorschlag für eine .desktop-Datei zeigen\n"
"  launcher-watch --check            Vorschläge für alle Programme prüfen\n"
"  launcher-watch --write-rules      rules.json aus dem Beispiel anlegen"

msgid "Usage: avincelaunch-helfer install|uninstall [options]"
msgstr "Verwendung: avincelaunch-helfer install|uninstall [Optionen]"

msgid "Usage: desktop-clean-toggle [--hide | --show | --status]"
msgstr "Verwendung: desktop-clean-toggle [--hide | --show | --status]"

msgid "Usage: launcher-add \"Program name\" [GROUP]"
msgstr "Verwendung: launcher-add \"Programmname\" [GRUPPE]"

msgid "Usage: launcher-move FILE.desktop [...] [GROUP]"
msgstr "Verwendung: launcher-move DATEI.desktop [...] [GRUPPE]"

